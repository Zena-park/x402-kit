{
  "name": "@x402.kit/buyer",
  "version": "0.2.0",
  "description": "Buyer-side x402 client — wrapFetch catches 402s, signs within a hard spending cap, retries once. Includes low-level signPayment for QR/POS flows.",
  "license": "Apache-2.0",
  "author": "Zena-park",
  "keywords": [
    "x402",
    "payment",
    "fetch",
    "axios",
    "ai-agent",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zena-park/x402-kit.git",
    "directory": "packages/buyer"
  },
  "homepage": "https://github.com/Zena-park/x402-kit/tree/main/packages/buyer#readme",
  "bugs": "https://github.com/Zena-park/x402-kit/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./axios": {
      "types": "./dist/axios.d.ts",
      "import": "./dist/axios.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@x402.kit/core": "^0.2.0",
    "viem": "^2.21.0"
  }
}
