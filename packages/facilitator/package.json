{
  "name": "@x402kit/facilitator",
  "version": "0.1.0",
  "description": "Self-hostable x402 facilitator — /verify, /settle, /supported. One config file + Docker, or embed via createFacilitator().",
  "license": "Apache-2.0",
  "author": "Zena-park",
  "keywords": [
    "x402",
    "facilitator",
    "payment",
    "eip-3009",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zena-park/x402-kit.git"
  },
  "homepage": "https://github.com/Zena-park/x402-kit#readme",
  "bugs": {
    "url": "https://github.com/Zena-park/x402-kit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "x402-facilitator": "./dist/server.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "Dockerfile"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@x402kit/core": "^0.1.0",
    "viem": "^2.21.0"
  }
}
