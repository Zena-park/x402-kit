{
  "name": "@x402.kit/seller",
  "version": "0.2.0",
  "description": "Seller-side x402 middleware — one-line paywall for hono/express/node, framework-agnostic core on web-standard Request/Response.",
  "license": "Apache-2.0",
  "author": "Zena-park",
  "keywords": [
    "x402",
    "payment",
    "middleware",
    "hono",
    "express",
    "next",
    "fastify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zena-park/x402-kit.git",
    "directory": "packages/seller"
  },
  "homepage": "https://github.com/Zena-park/x402-kit/tree/main/packages/seller#readme",
  "bugs": "https://github.com/Zena-park/x402-kit/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./pos": {
      "types": "./dist/pos.d.ts",
      "import": "./dist/pos.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@x402.kit/core": "^0.2.0",
    "viem": "^2.56.1"
  }
}
